{
  "name": "desktop-time-machine",
  "version": "1.0.0",
  "description": "Desktop Time Machine: A multi-environment retro desktop simulator for Windows",
  "main": "electron/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron test/verify-all.js",
    "test:security": "electron test/security-regressions.js && electron test/phase4-security.js",
    "test:skins": "electron test/phase4-skins.js",
    "test:architecture": "electron test/shared-computer.js",
    "test:apps": "electron test/shared-apps.js",
    "test:desktop": "electron test/phase4-desktop.js",
    "capture:desktop": "electron test/capture-phase4.js",
    "capture:fixes": "electron test/capture-fixes.js",
    "test:user-fixes": "electron test/user-fixes.js",
    "capture:user-fixes": "electron test/capture-user-fixes.js",
    "verify": "npm test && npm run test:security && npm run test:skins && npm run test:architecture && npm run test:apps && npm run test:desktop && npm run test:user-fixes && npm run test:msn && npm run test:keys && npm run test:media && npm run test:a11y",
    "screenshots": "electron test/capture-gallery.js",
    "test:msn": "electron test/msn-skin.js",
    "test:keys": "electron test/file-keyboard.js",
    "test:media": "electron test/media-player.js",
    "test:a11y": "electron test/accessibility.js"
  },
  "keywords": [
    "retro",
    "desktop",
    "windows95",
    "macos",
    "simulator",
    "electron"
  ],
  "author": "Desktop Time Machine Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.1"
  }
}
