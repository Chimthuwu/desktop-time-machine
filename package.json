{
  "name": "desktop-time-machine",
  "version": "1.0.0",
  "description": "Desktop Time Machine: A multi-environment retro desktop simulator for Windows",
  "main": "electron/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron test/verify-all.js",
    "test:security": "electron test/security-regressions.js && electron test/phase4-security.js",
    "test:skins": "electron test/phase4-skins.js",
    "test:architecture": "electron test/shared-computer.js",
    "test:apps": "electron test/shared-apps.js",
    "verify": "npm test && npm run test:security && npm run test:skins && npm run test:architecture && npm run test:apps",
    "screenshots": "electron test/capture-gallery.js"
  },
  "keywords": [
    "retro",
    "desktop",
    "windows95",
    "macos",
    "simulator",
    "electron"
  ],
  "author": "Desktop Time Machine Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.1"
  }
}
